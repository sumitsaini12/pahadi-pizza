# Instagram live gallery (server-only; never prefix these with NEXT_PUBLIC_).
# See docs/instagram-setup.md for how to create the token.
# Leave empty to show the curated posts from src/instagram-posts.ts instead.
INSTAGRAM_ACCESS_TOKEN=
# Optional: the Instagram user id. Defaults to "me", i.e. the account that owns the token.
INSTAGRAM_USER_ID=
